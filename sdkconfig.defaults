# Battlestation bring-up defaults.
# Target: ESP32-P4-WIFI6-Touch-LCD-7B, 1024x600 EK79007 + GT911, 32 MB flash,
# 32 MB PSRAM. These values mirror the verified Waveshare 08/09 examples, with
# demos disabled and the FPS counter enabled.
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# LVGL 9.5 integration. The BSP supplies esp_lvgl_adapter ~0.6; do not add the
# legacy esp_lvgl_port beside it.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_BUILD_EXAMPLES=n

# Keep the BSP's 3-framebuffer triple-partial tear-avoidance path. This is the
# configuration the Waveshare examples use on this panel.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5

# Adapter FPS statistics for the on-screen FPS readout.
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y

# Factory/BSP orientation. The 08 diagnostic uses 0; the product uses 180.
CONFIG_APP_TEAR_DOUBLE_DIRECT=y
# CONFIG_APP_TEAR_TRIPLE_PARTIAL is not set
# CONFIG_APP_TEAR_TRIPLE_FULL is not set
CONFIG_APP_ROTATION_180=y
# CONFIG_APP_ROTATION_0 is not set
CONFIG_APP_BACKLIGHT_PERCENT=60

# UART0 is the CH343P "USB TO UART" port. The native USB-C port remains
# available as a USB Serial/JTAG download port, but is not used as the console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
